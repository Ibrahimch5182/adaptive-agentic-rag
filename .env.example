# Copy this file to .env and fill in real values before running docker-compose.
# Never commit .env to version control.

# ── Local Docker Compose (defaults work as-is) ─────────────────────────────

# PostgreSQL password (used by both db and backend services)
POSTGRES_PASSWORD=change-me

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=secret_key_here

# Token lifetime in minutes (default: 1440 = 24h)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Phase 3: LLM (optional locally — heuristics/abstention are used without it)
GROQ_API_KEY=Groq_api_key_here
LLM_MODEL=openai/gpt-oss-20b

# Optional: managed/Qdrant Cloud instead of the local Docker Qdrant
QDRANT_API_KEY=

# --- For running backend locally without Docker ---
# DATABASE_URL=postgresql://contextguard:change-me@localhost:5432/contextguard


# ── Production-only (do not set these for local Docker Compose) ───────────

# ENVIRONMENT=production
# ALLOWED_HOSTS=["api.yourdomain.com"]
# CORS_ORIGINS=["https://yourdomain.com"]
# COOKIE_SECURE=true

# Production database/queue/vector store — managed services, not the Compose ones:
# DATABASE_URL=postgresql://user:pass@managed-postgres-host:5432/contextguard
# REDIS_URL=redis://managed-redis-host:6379
# QDRANT_URL=https://your-qdrant-cloud-endpoint

# Production object storage (S3-compatible). Originals are private — no public ACLs.
# STORAGE_BACKEND=s3
# S3_BUCKET=contextguard-uploads
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=                      # optional, for non-AWS S3-compatible providers
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
